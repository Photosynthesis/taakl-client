{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Taakl",
  "version": "0.1.0",
  "identifier": "app.taakl.timetracker",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:8000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Taakl",
        "width": 900,
        "height": 700,
        "minWidth": 400,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.taakl.app"
    }
  },
  "plugins": {
    "store": {}
  }
}
